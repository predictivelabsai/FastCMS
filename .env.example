# Copy to .env and fill in. Never commit real values.

# ── Database ───────────────────────────────────────────────────────────
# PostgreSQL (recommended for production). DB_URL is accepted as an alias.
DATABASE_URL=postgresql://fastcms:fastcms@localhost:5432/fastcms
# Leave DATABASE_URL empty to use the SQLite fallback files below.
DATABASE_PATH=data/fasthtml-cms.db
FASTSME_AUTH_DB=data/fastsme-accounts.sqlite
# Used by docker-compose's postgres service
POSTGRES_DB=fastcms
POSTGRES_USER=fastcms
POSTGRES_PASSWORD=fastcms

# ── App ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string
PORT=5001
# Non-interactive first admin (used by setup.py / docker-entrypoint.sh)
FASTCMS_ADMIN_EMAIL=
FASTCMS_ADMIN_PASSWORD=
# Public reads need no credential; set this to enable bearer-token API writes.
FASTSME_API_TOKEN=

# FastSME local accounts and transactional email
FASTSME_PUBLIC_URL=https://cms.fastsme.com
POSTMARK_API_TOKEN=
FROM_EMAIL=info@predictivelabs.ai

# ── Google sign-in (available) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cms.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# ── Enterprise sign-in adapters (stubs, disabled by default) ───────────
# Set AUTH_PROVIDERS_MOCK=1 only for local UI work/tests (mock identities).
AUTH_PROVIDERS_MOCK=0

# VIISP: Lithuanian e-government login (Smart-ID, Mobile-ID, banks, eID)
AUTH_VIISP_ENABLED=0
VIISP_PID=
VIISP_AUTH_SERVICE_URL=
VIISP_LOGIN_URL=
VIISP_POSTBACK_URL=
VIISP_PRIVATE_KEY_PATH=
VIISP_CERT_PATH=
AUTH_VIISP_ADMIN_GROUPS=

# Microsoft Entra ID (OIDC / SSO)
AUTH_ENTRA_ENABLED=0
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
AUTH_ENTRA_ADMIN_GROUPS=

# LDAP / Active Directory
AUTH_LDAP_ENABLED=0
LDAP_URL=ldaps://ldap.example.com
LDAP_BASE_DN=DC=example,DC=com
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={username})
AUTH_LDAP_ADMIN_GROUPS=
